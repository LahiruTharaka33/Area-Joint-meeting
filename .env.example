# Password for the organiser page at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign login cookies
SESSION_SECRET=replace-with-a-long-random-string
# Postgres connection string (Neon). Vercel sets this for you when you add Neon.
# Leave it out locally to use the built-in database in ./data
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
